# Copy to .env and edit. Every script reads these.
#   cp .env.example .env

# ---- cluster ----------------------------------------------------------------
OPENSEARCH_VERSION=3.1.0
OPENSEARCH_URL=http://localhost:9200
HEAP=2g

# Demo default is no security plugin (plain HTTP, no auth).
# To run WITH security: set DISABLE_SECURITY_PLUGIN=false, flip OPENSEARCH_URL
# to https://localhost:9200, and set DASHBOARDS_OPENSEARCH_HOSTS accordingly.
DISABLE_SECURITY_PLUGIN=true
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Ch4singSh4dows!2026
OPENSEARCH_VERIFY_TLS=false
DASHBOARDS_OPENSEARCH_HOSTS=["http://opensearch:9200"]
DASHBOARDS_URL=http://localhost:5601

# ---- index settings ---------------------------------------------------------
# zstd_no_dict is the compression story in the talk (slide 12). OpenSearch docs
# note it is not supported for Security Analytics indexes; if the Security
# Analytics detector misbehaves, set CODEC=best_compression and re-bootstrap.
CODEC=zstd_no_dict

# ---- data generation --------------------------------------------------------
# lite  =  24 agents,  2h spans, 1 day of metrics   (fast iteration, ~15s)
# stage = 212 agents,  6h spans, 2 days of metrics  (what you run on stage)
# full  = 212 agents, 24h spans, 5 days of metrics  (soak / screenshots)
PROFILE=stage
SEED=118

# ---- triage agent (optional) ------------------------------------------------
# Leave BEDROCK_ENABLED=false to use the scripted fallback triage runner.
# Set to true and fill in credentials to register a real ML Commons agent.
BEDROCK_ENABLED=false
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
